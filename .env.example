# Copy these settings into your hosting provider's environment variables.
A2A_BASE_PATH=/a2a
PUBLIC_BASE_URL=https://YOUR-ACTUAL-SERVICE.onrender.com/a2a/
GEMINI_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_IN_HOST_SETTINGS_ONLY
GEMINI_MODEL=gemini-3.8-flash
# Use the Render PostgreSQL connection string in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
